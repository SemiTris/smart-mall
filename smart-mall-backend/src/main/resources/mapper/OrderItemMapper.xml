<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  订单明细 Mapper
  被 OrderMapper.xml 的 <collection> 调用，用来装配订单下的商品列表。
  order_id / product_id / product_name 等下划线字段由
  map-underscore-to-camel-case 自动映射成 orderId / productId / productName。
-->
<mapper namespace="com.huashan.smartmallbackend.mapper.OrderItemMapper">

    <!-- 按订单 id 查询明细列表 -->
    <select id="selectByOrderId" resultType="OrderItem">
        SELECT id, order_id, product_id, product_name, price, quantity, subtotal
        FROM t_order_item
        WHERE order_id = #{orderId}
        ORDER BY id ASC
    </select>

</mapper>
